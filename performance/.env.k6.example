# Local por defecto. Para probar el droplet, usar la URL publica HTTPS.
K6_BASE_URL=http://host.docker.internal:4000

# Rutas GET separadas por coma. Mantener solo endpoints no destructivos.
K6_API_PATHS=/health

# Escenario ponderado: ruta:peso. Para endpoints autenticados se requiere sid.
K6_WEIGHTED_PATHS=/health:1,/ready:1

# Cookie BFF opcional para endpoints autenticados. No commitear una cookie real.
K6_SESSION_COOKIE=

# Produccion queda bloqueada salvo confirmacion explicita.
K6_ALLOW_PRODUCTION=false
K6_PRODUCTION_CONFIRMATION=

# Carga sostenida conservadora.
EDUTRACK_K6_RATE=5
EDUTRACK_K6_DURATION=2m
EDUTRACK_K6_PRE_ALLOCATED_VUS=10
EDUTRACK_K6_MAX_VUS=50

# Pico controlado.
EDUTRACK_K6_SPIKE_RATE=25

# Baseline inicial de produccion: perfil gradual y conservador.
EDUTRACK_K6_BASELINE_WARMUP_RATE=1
EDUTRACK_K6_BASELINE_NORMAL_RATE=3
EDUTRACK_K6_BASELINE_PEAK_RATE=5

# Tope absoluto aplicado por los scripts incluso si se configura una tasa mayor.
EDUTRACK_K6_MAX_ALLOWED_RATE=100

# Opcional: Prometheus remote write. El override de monitoreo configura la URL
# interna automaticamente; esta variable sirve para destinos personalizados.
K6_PROMETHEUS_RW_SERVER_URL=
K6_PROMETHEUS_RW_TREND_AS_NATIVE_HISTOGRAM=true

# Red creada por docker-compose.monitoring.yml.
EDUTRACK_MONITORING_NETWORK=edutrack-monitoring_monitoring

# Fijar la imagen permite ejecuciones reproducibles.
K6_IMAGE=grafana/k6:1.4.2
