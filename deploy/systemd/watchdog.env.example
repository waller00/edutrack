# Watchdog de contenedores de EduTrack.
# Copiar a /etc/edutrack/watchdog.env y ajustar antes de confiar en el.
#
# El instalador crea este archivo con WATCHDOG_DRY_RUN=1: al principio solo
# registra lo que haria. Revisar `journalctl -u edutrack-container-watchdog`
# durante unos dias y recien despues cambiar a 0.

# Directorio del repo en el servidor.
EDUTRACK_DIR=/root/edutrack

# Archivos compose del despliegue cloud, en el mismo orden que dc-cloud.sh.
# No hace falta docker-compose.keycloak-admin.yml: el watchdog solo resuelve
# web, auth y reverse-proxy.
EDUTRACK_COMPOSE_FILES="docker-compose.cloud.yml docker-compose.proxy.yml docker-compose.close-ports.prod.yml"

# Solo servicios stateless. PostgreSQL y Keycloak quedan fuera a proposito:
# reiniciarlos por un healthcheck transitorio es mas riesgoso que avisar.
WATCHDOG_SERVICES="web auth reverse-proxy"

# N chequeos unhealthy seguidos antes de actuar.
WATCHDOG_CONSECUTIVE=3

# Tope de reinicios por servicio dentro de la ventana.
WATCHDOG_MAX_RESTARTS=3
WATCHDOG_WINDOW_SECONDS=3600

# Espera minima entre reinicios del mismo servicio.
WATCHDOG_COOLDOWN_SECONDS=300

# 1 = solo registrar; 0 = reiniciar de verdad.
WATCHDOG_DRY_RUN=1

WATCHDOG_STATE_DIR=/var/lib/edutrack-watchdog/state
WATCHDOG_TEXTFILE_DIR=/var/lib/edutrack-watchdog/textfile
