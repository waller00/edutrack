{
  "name": "auth-service",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:ci": "tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/server.js",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed-all.mjs",
    "seed:clean": "node prisma/seed-clean.mjs",
    "seed:academic": "tsx prisma/seed-academic-catalog.ts",
    "seed:teachers": "tsx prisma/seed-teachers.ts",
    "seed:bootstrap": "tsx prisma/seed-bootstrap.ts",
    "seed:realistic": "tsx prisma/seed-realistic-dataset.ts",
    "seed:biometric": "node prisma/seed-biometric-adms.mjs",
    "vapid:keys": "node --input-type=module -e \"import w from 'web-push'; const k=w.generateVAPIDKeys(); console.log('VAPID_PUBLIC_KEY='+k.publicKey); console.log('VAPID_PRIVATE_KEY='+k.privateKey); console.log('VAPID_SUBJECT=mailto:cambiar@tu-dominio.com');\""
  },
  "prisma": {
    "seed": "node prisma/seed-all.mjs"
  },
  "dependencies": {
    "@faker-js/faker": "^10.1.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.16.1",
    "@types/pdfkit": "^0.17.3",
    "argon2": "^0.40.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.13",
    "openai": "^4.104.0",
    "otplib": "^13.4.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.14.10",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.9",
    "prisma": "^5.16.1",
    "supertest": "^7.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.5.3",
    "vitest": "^2.1.9"
  }
}
