generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Alcance del permiso para la UI y futura autorización fina (propios vs todos).
enum PermissionScope {
  OWN
  ALL
}

enum InAppNotificationType {
  LICENSE_CREATED
  LICENSE_UPDATED
  EVENT_ASSIGNED
}

/// Rol de organización (`code` estable para JWT / guards; ej. ADMIN, TEACHER, CUSTOM_1).
model OrgRole {
  id        String   @id @default(uuid())
  code      String   @unique
  label     String
  builtIn   Boolean  @default(false)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  grants    RolePermission[]

  @@index([active])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String?  @unique
  nationalId   String?  @unique
  /// Vencimiento de la cédula de identidad (según DNI / OCR).
  nationalIdDocumentExpiresAt DateTime?
  firstName    String?
  lastName     String?
  name         String?
  phone        String?
  birthdate    DateTime?
  passwordHash String?
  googleId     String?  @unique
  roleId       String
  orgRole      OrgRole   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([roleId])
  // relations
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  refreshTokens      RefreshToken[]
  attendances        Attendance[]
  events             Event[]
  assignedEvents     Event[]       @relation("EventAssignment")
  medicalLeaves      MedicalLeave[]
  webPushSubscriptions WebPushSubscription[]
  inAppNotifications InAppNotification[]
  // security
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int       @default(0)
  lockUntil           DateTime?
  isApproved          Boolean   @default(true)
  approvedAt          DateTime?
  isActive            Boolean   @default(true)
  /// Prueba de vida (Didit) completada al registrarse (si el sistema la exigía).
  livenessVerifiedAt  DateTime?
}

model PasswordReset {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerification {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Avisos dentro de la app (persisten aunque el push se pierda).
model InAppNotification {
  id        String                 @id @default(uuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      InAppNotificationType
  title     String
  body      String
  actionUrl String?
  readAt    DateTime?
  createdAt DateTime               @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// Configuración global (fila única `default`).
model SystemSettings {
  id                    String   @id @default("default")
  livenessCheckEnabled  Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

enum LivenessSessionStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  DECLINED
  EXPIRED
  ABANDONED
  ERROR
}

/// Sesión de prueba de vida Didit (pre-registro). `id` se envía como `vendor_data`.
model LivenessSession {
  id              String                 @id @default(uuid())
  diditSessionId  String?                @unique
  status          LivenessSessionStatus  @default(PENDING)
  diditStatusRaw  String?
  createdAt       DateTime               @default(now())
  expiresAt       DateTime
  consumedAt      DateTime?
  /// Email vinculado (si al crear la sesión se envió); debe coincidir con el registro.
  email           String?
}

/// Suscripciones Web Push (navegador); una por endpoint (dispositivo).
model WebPushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model RefreshToken {
  id             String   @id @default(uuid())
  tokenHash      String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedById   String?
  createdAt      DateTime @default(now())
  userAgent      String?
  ipAddress      String?

  @@index([userId])
}

// Sistema de Asistencias
enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum AttendanceStatus {
  // Estados para CHECK_IN
  PRESENT
  LATE
  ABSENT_NOT_JUSTIFIED
  ABSENT_JUSTIFIED
  
  // Estados para CHECK_OUT
  EXIT
  EARLY_EXIT
}

model Attendance {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        AttendanceType
  status      AttendanceStatus @default(PRESENT)
  date        DateTime
  time        DateTime
  notes       String?
  eventId     String?
  event       Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([date])
  @@index([eventId])
}

// Sistema de Eventos y Turnos
enum EventType {
  // Para STAFF
  JORNADA_LABORAL
  REUNION
  // Para TEACHER  
  CLASE
  // Comunes
  EVENTO
  CAPACITACION
  CITA_MEDICA
}

enum EventStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

/// Catálogo global de permisos (código único, p. ej. `events.read`).
model Permission {
  id           String           @id @default(uuid())
  code         String           @unique
  module       String
  action       String
  isSystem     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  roleGrants   RolePermission[]

  @@index([module])
}

/// Asignación por rol (FK a OrgRole): labels por rol para un mismo permiso catálogo.
model RolePermission {
  roleId        String
  orgRole       OrgRole        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId  String
  permission    Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  enabled       Boolean        @default(true)
  scope         PermissionScope @default(OWN)
  label         String

  @@id([roleId, permissionId])
  @@index([permissionId])
}

/// Cursos para asociar eventos (clases / grupos).
model Course {
  id          String   @id @default(uuid())
  name        String
  code        String?  @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  events      Event[]

  @@index([isActive])
}

model Event {
  id              String         @id @default(uuid())
  title           String
  description     String?
  type            EventType
  status          EventStatus    @default(SCHEDULED)
  startDate       DateTime
  endDate         DateTime?
  startTime       DateTime?
  endTime         DateTime?
  location        String?
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedUserId  String?
  assignedUser    User?          @relation("EventAssignment", fields: [assignedUserId], references: [id], onDelete: SetNull)
  courseId        String?
  course          Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  recurrenceType  RecurrenceType @default(NONE)
  recurrenceEnd   DateTime?
  isRecurring     Boolean        @default(false)
  daysOfWeek      Int[]          @default([]) // Array de días de la semana (0=Domingo, 1=Lunes, etc.)
  parentEventId   String?
  parentEvent     Event?         @relation("EventRecurrence", fields: [parentEventId], references: [id], onDelete: SetNull)
  childEvents     Event[]        @relation("EventRecurrence")
  attendances     Attendance[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([assignedUserId])
  @@index([courseId])
  @@index([startDate])
  @@index([type])
}

// Sistema de Licencias Médicas
enum MedicalLeaveType {
  MEDICAL_LEAVE
  WORK_LEAVE
  OTHER
}

enum MedicalLeaveStatus {
  ACTIVE
  INACTIVE
}

model MedicalLeave {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        MedicalLeaveType
  status      MedicalLeaveStatus  @default(ACTIVE)
  startDate   DateTime
  endDate     DateTime
  reason      String
  doctorName  String?
  doctorPhone String?
  certificate String? // URL del certificado médico
  approvedBy  String?
  approvedAt  DateTime?
  deactivatedBy String?
  deactivatedAt DateTime?
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@index([startDate])
  @@index([status])
}
