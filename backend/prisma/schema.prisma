generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Alcance del permiso para la UI y futura autorización fina (propios vs todos).
enum PermissionScope {
  OWN
  ALL
}

enum InAppNotificationType {
  LICENSE_CREATED
  LICENSE_UPDATED
  EVENT_ASSIGNED
  ATTENDANCE_INCIDENT
  /// Observación registrada sobre una libreta (RF-091).
  GRADEBOOK_OBSERVATION
  GRADEBOOK_ENDORSED
  GRADEBOOK_MESSAGE
  /// El período está por cerrar y la libreta todavía tiene pendientes.
  GRADEBOOK_PERIOD_CLOSING
}

/// Registro append-only de acciones relevantes (RF-11). Sin updates ni deletes desde la app.
enum AuditAction {
  AUTH_LOGIN_SUCCESS
  AUTH_LOGIN_FAILURE
  AUTH_LOGOUT
  AUTH_GOOGLE_LOGIN_SUCCESS
  USER_CREATED_BY_ADMIN
  USER_UPDATED_BY_ADMIN
  USER_DELETED_BY_ADMIN
  USER_ACCOUNT_LOCK_TOGGLED
  ADMIN_PASSWORD_RESET_ISSUED
  MEDICAL_LEAVE_CREATED
  MEDICAL_LEAVE_UPDATED
  MEDICAL_LEAVE_DEACTIVATED
  SYSTEM_SETTINGS_UPDATED
  EVENT_CREATED
  BIOMETRIC_LINK_STARTED
  BIOMETRIC_LINK_DETECTED
  BIOMETRIC_LINK_CONFIRMED
  BIOMETRIC_LINK_CANCELLED
  BIOMETRIC_MAPPING_REMOVED
  ATTENDANCE_MANUAL_UPDATED
  ATTENDANCE_JUSTIFIED
  ATTENDANCE_INCIDENT_RESOLVED
  SUBSTITUTION_CREATED
  MOODLE_GRADES_PUSHED
  // Se conserva para poder leer auditorías históricas del módulo retirado.
  QUERY_ASSISTANT_QUERY_EXECUTED
  STUDENT_ROLL_CALL_TAKEN
  STUDENT_ROLL_CALL_UPDATED
  STUDENT_ROLL_CALL_DELETED
  STUDENT_ROLL_CALL_REOPENED
  STUDENT_ATTENDANCE_JUSTIFIED
  ACADEMIC_CONFIG_CREATED
  ACADEMIC_CONFIG_UPDATED
  ACADEMIC_CONFIG_DEACTIVATED
  ASSESSMENT_CREATED
  ASSESSMENT_UPDATED
  ASSESSMENT_DELETED
  GRADE_ENTERED
  GRADE_UPDATED
  GRADE_PERIOD_CLOSED
  GRADE_PERIOD_REOPENED
  MOODLE_GRADES_IMPORTED
  GRADEBOOK_OBSERVED
  GRADEBOOK_ENDORSED
}

/// Rol de organización (`code` estable para JWT / guards; ej. ADMIN, TEACHER, CUSTOM_1).
model OrgRole {
  id        String           @id @default(uuid())
  code      String           @unique
  label     String
  builtIn   Boolean          @default(false)
  active    Boolean          @default(true)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  users     User[]
  grants    RolePermission[]

  @@index([active])
}

model User {
  id                                     String                           @id @default(uuid())
  email                                  String                           @unique
  username                               String?                          @unique
  nationalId                             String?                          @unique
  /// Vencimiento de la cédula de identidad (según DNI / OCR).
  nationalIdDocumentExpiresAt            DateTime?
  firstName                              String?
  lastName                               String?
  name                                   String?
  phone                                  String?
  birthdate                              DateTime?
  googleId                               String?                          @unique
  /// Id del usuario espejo en Moodle (integración). Fuente de verdad sigue siendo EduTrack.
  moodleUserId                           Int?                             @unique
  roleId                                 String
  orgRole                                OrgRole                          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt                              DateTime                         @default(now())
  updatedAt                              DateTime                         @updatedAt
  // relations
  emailVerifications                     EmailVerification[]
  attendances                            Attendance[]
  events                                 Event[]
  assignedEvents                         Event[]                          @relation("EventAssignment")
  medicalLeaves                          MedicalLeave[]
  webPushSubscriptions                   WebPushSubscription[]
  inAppNotifications                     InAppNotification[]
  biometricMappings                      BiometricUserMapping[]
  biometricLinkRequests                  BiometricLinkRequest[]
  biometricPunches                       BiometricPunch[]
  attendanceIncidents                    AttendanceIncident[]
  attendanceJustificationsCreated        AttendanceJustification[]        @relation("AttendanceJustificationCreatedBy")
  studentRollCallsTaken                  StudentAttendanceSession[]       @relation("StudentAttendanceSessionTakenBy")
  studentRollCallsLocked                 StudentAttendanceSession[]       @relation("StudentAttendanceSessionLockedBy")
  studentAttendanceEntries               StudentAttendanceEntry[]         @relation("StudentAttendanceEntryMarkedBy")
  studentAttendanceJustificationsCreated StudentAttendanceJustification[] @relation("StudentAttendanceJustificationCreatedBy")
  substitutionsCreated                   Substitution[]                   @relation("SubstitutionCreatedBy")
  substitutionsAsOriginal                Substitution[]                   @relation("SubstitutionOriginalTeacher")
  substitutionsAsSubstitute              Substitution[]                   @relation("SubstitutionSubstituteTeacher")
  auditEvents                            AuditLog[]
  teacherProfile                         TeacherProfile?
  activityTypes                          ActivityType[]                   @relation("ActivityTypeOwner")
  gradeBooks                             GradeBook[]                      @relation("GradeBookTeacher")
  assessmentsCreated                     Assessment[]                     @relation("AssessmentCreatedBy")
  assessmentGradesGiven                  AssessmentGrade[]                @relation("AssessmentGradeGradedBy")
  gradeRevisions                         GradeRevision[]                  @relation("GradeRevisionChangedBy")
  gradeBookPeriodsClosed                 GradeBookPeriod[]                @relation("GradeBookPeriodClosedBy")
  gradeBookPeriodsReopened               GradeBookPeriod[]                @relation("GradeBookPeriodReopenedBy")
  periodGradesUpdated                    PeriodGrade[]                    @relation("PeriodGradeUpdatedBy")
  teacherMeetingRecords                  TeacherMeetingRecord[]           @relation("TeacherMeetingRecordCreatedBy")
  endorsements                           Endorsement[]                    @relation("EndorsementActor")
  gradeBookMessages                      GradeBookMessage[]               @relation("GradeBookMessageAuthor")
  gradeBookAccessLogs                    GradeBookAccessLog[]             @relation("GradeBookAccessLogUser")
  gradeBookPlannings                     GradeBookPlanning[]              @relation("GradeBookPlanningUpdatedBy")
  courseDevelopmentEntries               CourseDevelopmentEntry[]         @relation("CourseDevelopmentCreatedBy")
  // security
  emailVerifiedAt                        DateTime?
  failedLoginAttempts                    Int                              @default(0)
  lockUntil                              DateTime?
  isApproved                             Boolean                          @default(true)
  approvedAt                             DateTime?
  isActive                               Boolean                          @default(true)
  /// Prueba de vida (Didit) completada al registrarse (si el sistema la exigía).
  livenessVerifiedAt                     DateTime?

  @@index([roleId])
}

/// Perfil docente operativo (cuenta en `User` con rol TEACHER).
model TeacherProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  isActive    Boolean  @default(true)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model EmailVerification {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Avisos dentro de la app (persisten aunque el push se pierda).
model InAppNotification {
  id        String                @id @default(uuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      InAppNotificationType
  title     String
  body      String
  actionUrl String?
  readAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model AuditLog {
  id          String      @id @default(uuid())
  occurredAt  DateTime    @default(now())
  action      AuditAction
  actorUserId String?
  actor       User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorIp     String?     @db.VarChar(45)
  userAgent   String?     @db.VarChar(512)
  source      String      @default("API") @db.VarChar(32)
  entityType  String?     @db.VarChar(64)
  entityId    String?     @db.VarChar(36)
  metadata    Json?

  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
}

/// Configuración global (fila única `default`).
model SystemSettings {
  id                                  String   @id @default("default")
  livenessCheckEnabled                Boolean  @default(false)
  attendanceNoShowGraceMinutes        Int      @default(15)
  attendanceLateToleranceMinutes      Int      @default(5)
  attendanceEarlyExitToleranceMinutes Int      @default(5)
  /// Si el hueco entre el fin de una clase y el inicio de la siguiente es >= este valor (minutos), se exige nueva entrada biométrica.
  attendanceClassBridgeGapMinutes     Int      @default(60)
  attendanceMonitorEnabled            Boolean  @default(true)
  attendanceMonitorIntervalMs         Int      @default(120000)
  biometricDuplicateWindowMinutes     Int      @default(5)
  /// Integración Moodle: habilita el worker de outbox y la reconciliación periódica.
  moodleSyncEnabled                   Boolean  @default(false)
  /// Intervalo (ms) de la reconciliación completa EduTrack→Moodle.
  moodleReconcileIntervalMs           Int      @default(900000)
  /// Sincroniza también estudiantes (matrícula) como usuarios/inscripciones de Moodle.
  moodleSyncStudents                  Boolean  @default(false)
  /// Zona horaria IANA institucional (fechas civiles, horarios, asistencias).
  institutionTimezone                 String   @default("America/Montevideo")
  /// Horas tras el fin de la clase (o el pase de lista, lo que sea posterior) en que el
  /// docente todavía puede editar su planilla. Después solo admin, con auditoría.
  studentRollCallEditWindowHours      Int      @default(48)
  /// Habilita la sugerencia "copiar la lista de la hora anterior" del mismo grupo.
  studentRollCallCopyPreviousEnabled  Boolean  @default(true)
  /// % de clases del día con ausencia a partir del cual el día consolida como falta entera
  /// (por debajo, y con al menos una ausencia, consolida como media falta).
  studentDailyAbsenceThresholdPercent Int      @default(50)
  /// Días tras la fecha de la evaluación en que el docente todavía puede editar sus notas.
  /// Después sólo `gradebook.manage`, y esa escritura se audita siempre.
  gradebookEditWindowDays             Int      @default(30)
  updatedAt                           DateTime @updatedAt
}

/// Cola persistente (patrón outbox) para sincronizar entidades con Moodle con reintentos.
/// Garantiza que un fallo transitorio no desincronice de forma permanente y silenciosa.
model MoodleSyncTask {
  id          String             @id @default(uuid())
  type        MoodleSyncTaskType
  /// Clave de deduplicación (p. ej. "user:<uuid>"): evita encolar duplicados pendientes.
  dedupeKey   String             @unique
  payload     Json
  status      MoodleSyncStatus   @default(PENDING)
  attempts    Int                @default(0)
  maxAttempts Int                @default(8)
  lastError   String?            @db.Text
  /// No procesar antes de este instante (backoff exponencial).
  runAfter    DateTime           @default(now())
  /// Marca de claim para evitar doble procesamiento entre ticks.
  lockedAt    DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, runAfter])
}

enum MoodleSyncTaskType {
  USER_UPSERT
  STUDENT_USER_UPSERT
}

enum MoodleSyncStatus {
  PENDING
  DONE
  FAILED
}

/// Mapeo persistente entre entidades de EduTrack y objetos de Moodle (categorías, cursos,
/// estudiantes-espejo). Da idempotencia y permite detectar/reparar divergencias (drift).
model MoodleObjectMap {
  id         String           @id @default(uuid())
  objectType MoodleObjectType
  /// Id local en EduTrack (uuid de Course/CourseOffering/SchoolYear/Student).
  localId    String
  /// Id numérico del objeto en Moodle.
  moodleId   Int
  /// idnumber canónico usado en Moodle (ej. "et-offering-<uuid>").
  idnumber   String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([objectType, localId])
  @@unique([objectType, idnumber])
  @@index([objectType])
}

enum MoodleObjectType {
  CATEGORY
  COURSE
  /// Curso de Moodle por asignatura dentro de curso/año (+ orientación opcional).
  SUBJECT_COURSE
  STUDENT
}

/// Origen del acceso docente otorgado en Moodle (para revocación segura y trazable).
enum MoodleEnrolmentSource {
  TEACHER_EVENT
  SUBSTITUTE
  STUDENT_ENROLLMENT
}

enum MoodleEnrolmentStatus {
  ACTIVE
  REVOKED
}

/// Tracking fino de las inscripciones que la integración otorga en Moodle.
/// Permite saber qué acceso fue creado por titularidad de evento vs. suplencia vs. matrícula,
/// y revocar de forma idempotente sin depender únicamente del estado remoto de Moodle.
model MoodleEnrolmentMap {
  id             String                @id @default(uuid())
  /// Id local del inscripto: polimórfico (User para docentes/suplentes, Student para alumnos).
  /// Por eso NO lleva FK a User: una FK rompería la matrícula de estudiantes.
  userId         String
  moodleUserId   Int
  moodleCourseId Int
  roleId         Int
  sourceType     MoodleEnrolmentSource
  /// Referencia opcional al origen (p. ej. eventId); el dedupe lógico es (sourceType,userId,curso).
  sourceId       String?
  /// Ventana de acceso efectiva (suplencias): se refleja en timestart/timeend de Moodle.
  startsAt       DateTime?
  endsAt         DateTime?
  status         MoodleEnrolmentStatus @default(ACTIVE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([sourceType, userId, moodleCourseId])
  @@index([sourceType, status])
  @@index([moodleCourseId])
  @@index([userId])
  @@index([status, endsAt])
}

enum LivenessSessionStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  DECLINED
  EXPIRED
  ABANDONED
  ERROR
}

/// Sesión de prueba de vida Didit (pre-registro). `id` se envía como `vendor_data`.
model LivenessSession {
  id             String                @id @default(uuid())
  diditSessionId String?               @unique
  status         LivenessSessionStatus @default(PENDING)
  diditStatusRaw String?
  createdAt      DateTime              @default(now())
  expiresAt      DateTime
  consumedAt     DateTime?
  /// Email vinculado (si al crear la sesión se envió); debe coincidir con el registro.
  email          String?
}

/// Suscripciones Web Push (navegador); una por endpoint (dispositivo).
model WebPushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Sistema de Asistencias
enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum BiometricPunchType {
  CHECK_IN
  CHECK_OUT
  UNKNOWN
}

enum BiometricPunchProcessStatus {
  PENDING
  PROCESSED
  FAILED
  DUPLICATE
  /// Marca capturada durante vinculación pendiente de confirmación en EduTrack.
  LINK_CAPTURED
}

enum BiometricLinkRequestStatus {
  WAITING_PUNCH
  PENDING_CONFIRM
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum AttendanceStatus {
  // Estados para CHECK_IN
  PRESENT
  LATE
  ABSENT_NOT_JUSTIFIED
  ABSENT_JUSTIFIED

  // Estados para CHECK_OUT
  EXIT
  EARLY_EXIT

  // Estados operativos y de revisión
  JUSTIFIED
  FREE
  PENDING_REVIEW
  SUBSTITUTED
  SUSPENDED
  OUT_OF_SCHEDULE
  UNIDENTIFIED_PUNCH
}

model Attendance {
  id             String                    @id @default(uuid())
  userId         String
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           AttendanceType
  status         AttendanceStatus          @default(PRESENT)
  date           DateTime
  time           DateTime
  notes          String?
  eventId        String?
  event          Event?                    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  /// Ciclo lectivo de la marca. Se deriva del evento cuando hay uno; para marcas sin
  /// evento (manual / biométrica fuera de horario) se fija el ciclo activo al crearla.
  /// Permite segmentar el listado admin por ciclo sin depender de la relación con Event.
  schoolYearId   String?
  schoolYear     SchoolYear?               @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)
  biometricPunch BiometricPunch?
  incidents      AttendanceIncident[]
  justifications AttendanceJustification[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([userId])
  @@index([date])
  @@index([eventId])
  @@index([schoolYearId])
}

enum AttendanceJustificationType {
  ABSENCE
  LATE_ARRIVAL
  EARLY_EXIT
  OTHER
}

model AttendanceJustification {
  id              String                      @id @default(uuid())
  attendanceId    String
  attendance      Attendance                  @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  type            AttendanceJustificationType @default(OTHER)
  reason          String
  notes           String?                     @db.Text
  attachment      String?                     @db.Text
  previousStatus  AttendanceStatus
  newStatus       AttendanceStatus
  createdByUserId String?
  createdBy       User?                       @relation("AttendanceJustificationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime                    @default(now())

  @@index([attendanceId])
  @@index([createdByUserId])
  @@index([createdAt])
}

enum AttendanceIncidentType {
  LATE_ARRIVAL
  TEACHER_NO_SHOW
  EARLY_EXIT
}

enum AttendanceIncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model AttendanceIncident {
  id               String                   @id @default(uuid())
  type             AttendanceIncidentType
  status           AttendanceIncidentStatus @default(OPEN)
  title            String
  description      String?
  severity         String                   @default("HIGH")
  userId           String
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId          String?
  event            Event?                   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  attendanceId     String?
  attendance       Attendance?              @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  biometricPunchId String?
  biometricPunch   BiometricPunch?          @relation(fields: [biometricPunchId], references: [id], onDelete: SetNull)
  detectedAt       DateTime                 @default(now())
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  resolvedBy       String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([status, type])
  @@index([eventId])
  @@index([userId])
  @@index([detectedAt])
}

model BiometricDevice {
  id           String                 @id @default(uuid())
  code         String                 @unique
  /// Número de serie ADMS del terminal (query `SN`); si no se define, se usa `code`.
  admsSerial   String?                @unique
  name         String
  secretHash   String
  timezone     String                 @default("America/Montevideo")
  isActive     Boolean                @default(true)
  allowedIps   String[]               @default([])
  lastSeenAt   DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  punches      BiometricPunch[]
  mappings     BiometricUserMapping[]
  linkRequests BiometricLinkRequest[]

  @@index([isActive])
}

model BiometricLinkRequest {
  id                    String                     @id @default(uuid())
  userId                String
  user                  User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId              String
  device                BiometricDevice            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  status                BiometricLinkRequestStatus @default(WAITING_PUNCH)
  candidateDeviceUserId String?
  candidatePunchId      String?
  expiresAt             DateTime
  confirmedAt           DateTime?
  createdByIp           String?                    @db.VarChar(45)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@index([deviceId, status])
  @@index([userId, status])
  @@index([expiresAt])
}

model BiometricUserMapping {
  id           String           @id @default(uuid())
  deviceId     String
  device       BiometricDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceUserId String
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  punches      BiometricPunch[]

  @@unique([deviceId, deviceUserId])
  @@unique([deviceId, userId])
  @@index([userId])
  @@index([isActive])
}

model BiometricPunch {
  id            String                      @id @default(uuid())
  deviceId      String
  device        BiometricDevice             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  mappingId     String?
  mapping       BiometricUserMapping?       @relation(fields: [mappingId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendanceId  String?                     @unique
  attendance    Attendance?                 @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  externalId    String?
  deviceUserId  String
  occurredAt    DateTime
  receivedAt    DateTime                    @default(now())
  punchType     BiometricPunchType          @default(UNKNOWN)
  processStatus BiometricPunchProcessStatus @default(PENDING)
  processError  String?
  payload       Json
  incidents     AttendanceIncident[]
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  @@unique([deviceId, deviceUserId, occurredAt])
  @@unique([deviceId, externalId])
  @@index([processStatus])
  @@index([occurredAt])
}

// Sistema de Eventos y Turnos
enum EventType {
  // Para STAFF
  JORNADA_LABORAL
  REUNION
  // Para TEACHER  
  CLASE
  // Comunes
  EVENTO
  CAPACITACION
  CITA_MEDICA
}

enum EventStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

/// Catálogo global de permisos (código único, p. ej. `events.read`).
model Permission {
  id         String           @id @default(uuid())
  code       String           @unique
  module     String
  action     String
  isSystem   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  roleGrants RolePermission[]

  @@index([module])
}

/// Asignación por rol (FK a OrgRole): labels por rol para un mismo permiso catálogo.
model RolePermission {
  roleId       String
  orgRole      OrgRole         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  enabled      Boolean         @default(true)
  scope        PermissionScope @default(OWN)
  label        String

  @@id([roleId, permissionId])
  @@index([permissionId])
}

/// Ciclo lectivo (segmentación global de datos operativos del liceo).
enum SchoolYearStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum AcademicLevel {
  EBI
  EMS
}

enum SubjectAssociationType {
  NIVEL_COMPLETO
  CURSO_COMPLETO
  TRONCO_COMUN_CURSO
  ORIENTACION
  OPTATIVA
  PERSONALIZADA
}

model SchoolYear {
  id                        String                     @id @default(uuid())
  /// Año calendario del ciclo (ej. 2026); único en la institución.
  code                      Int                        @unique
  label                     String
  startsOn                  DateTime?
  endsOn                    DateTime?
  status                    SchoolYearStatus           @default(PLANNED)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  courseOfferings           CourseOffering[]
  events                    Event[]
  attendances               Attendance[]
  studentEnrollments        StudentEnrollment[]
  studentAttendanceSessions StudentAttendanceSession[]
  tuitionYears              StudentTuitionYear[]
  tuitionMonths             StudentTuitionMonth[]
  nonWorkingDays            NonWorkingDay[]
  courseOrientations        CourseOrientation[]
  subjectAssignments        SubjectCourseAssignment[]
  academicPeriods           AcademicPeriod[]
  gradeBooks                GradeBook[]
  teacherMeetingRecords     TeacherMeetingRecord[]
  academicAlertRules        AcademicAlertRule[]

  @@index([status])
}

/// Cursos para asociar eventos (clases / grupos).
model Course {
  id                 String                    @id @default(uuid())
  name               String
  code               String?                   @unique
  level              AcademicLevel?
  sortOrder          Int                       @default(0)
  description        String?
  isActive           Boolean                   @default(true)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  legacySubjects     Subject[]
  offerings          CourseOffering[]
  orientations       CourseOrientation[]
  subjectAssignments SubjectCourseAssignment[]

  @@index([isActive])
  @@index([level, sortOrder])
}

/// Catálogo configurable de orientaciones/subdivisiones académicas.
model Orientation {
  id                        String                     @id @default(uuid())
  name                      String
  code                      String?                    @unique
  description               String?                    @db.Text
  isActive                  Boolean                    @default(true)
  sortOrder                 Int                        @default(0)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  courses                   CourseOrientation[]
  subjectAssignments        SubjectCourseAssignment[]
  events                    Event[]
  studentEnrollments        StudentEnrollment[]
  studentAttendanceSessions StudentAttendanceSession[]
  gradeBooks                GradeBook[]

  @@index([isActive])
  @@index([sortOrder, name])
}

/// Oferta anual de un curso del catálogo dentro de un ciclo lectivo.
/// Permite cerrar/abrir años sin duplicar Course ni sus Subject.
model CourseOffering {
  id                        String                     @id @default(uuid())
  courseId                  String
  course                    Course                     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  schoolYearId              String
  schoolYear                SchoolYear                 @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  isActive                  Boolean                    @default(true)
  isOffered                 Boolean                    @default(true)
  visibleInFilters          Boolean                    @default(true)
  notes                     String?                    @db.Text
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  events                    Event[]
  studentEnrollments        StudentEnrollment[]
  legacySubjects            Subject[]
  studentAttendanceSessions StudentAttendanceSession[]
  gradeBooks                GradeBook[]
  teacherMeetingRecords     TeacherMeetingRecord[]

  @@unique([courseId, schoolYearId])
  @@index([schoolYearId, isActive])
  @@index([schoolYearId, isOffered, visibleInFilters])
  @@index([courseId])
}

/// Relación opcional de orientación disponible para un curso y, si corresponde, ciclo lectivo.
model CourseOrientation {
  id                        String                     @id @default(uuid())
  courseId                  String
  course                    Course                     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orientationId             String
  orientation               Orientation                @relation(fields: [orientationId], references: [id], onDelete: Cascade)
  schoolYearId              String?
  schoolYear                SchoolYear?                @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  isActive                  Boolean                    @default(true)
  isOffered                 Boolean                    @default(true)
  visibleInFilters          Boolean                    @default(true)
  notes                     String?                    @db.Text
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  events                    Event[]
  studentEnrollments        StudentEnrollment[]
  studentAttendanceSessions StudentAttendanceSession[]
  gradeBooks                GradeBook[]
  teacherMeetingRecords     TeacherMeetingRecord[]

  @@unique([courseId, orientationId, schoolYearId])
  @@index([courseId, isActive])
  @@index([orientationId, isActive])
  @@index([schoolYearId, isActive])
  @@index([schoolYearId, isOffered, visibleInFilters])
}

/// Catálogo global de asignaturas. La disponibilidad por nivel/curso/orientación
/// se define en SubjectCourseAssignment.
model Subject {
  id                        String                     @id @default(uuid())
  name                      String
  code                      String?
  description               String?                    @db.Text
  sortOrder                 Int                        @default(0)
  isActive                  Boolean                    @default(true)
  /// Compatibilidad histórica: asignaturas creadas antes del catálogo flexible.
  courseId                  String?
  course                    Course?                    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  /// Compatibilidad histórica por ciclo.
  courseOfferingId          String?
  courseOffering            CourseOffering?            @relation(fields: [courseOfferingId], references: [id], onDelete: SetNull)
  courseAssignments         SubjectCourseAssignment[]
  events                    Event[]
  studentAttendanceSessions StudentAttendanceSession[]
  gradeBooks                GradeBook[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([courseId])
  @@index([courseOfferingId])
  @@index([isActive])
  @@index([sortOrder, name])
  @@map("asignaturas")
}

/// Asociación flexible de asignaturas: nivel completo, curso completo, tronco común
/// de curso, orientación o configuración personalizada por ciclo.
model SubjectCourseAssignment {
  id               String                 @id @default(uuid())
  subjectId        String
  subject          Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  level            AcademicLevel?
  courseId         String?
  course           Course?                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orientationId    String?
  orientation      Orientation?           @relation(fields: [orientationId], references: [id], onDelete: Cascade)
  schoolYearId     String?
  schoolYear       SchoolYear?            @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  associationType  SubjectAssociationType
  isActive         Boolean                @default(true)
  isOffered        Boolean                @default(true)
  visibleInFilters Boolean                @default(true)
  sortOrder        Int                    @default(0)
  notes            String?                @db.Text
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([subjectId, isActive])
  @@index([level, isActive])
  @@index([courseId, isActive])
  @@index([orientationId, isActive])
  @@index([schoolYearId, isActive])
  @@index([schoolYearId, isOffered, visibleInFilters])
  @@index([associationType])
}

/// Estado de matrícula para informes de abandono y seguimiento administrativo.
enum StudentEnrollmentStatus {
  ACTIVE
  WITHDRAWN
  GRADUATED
  TRANSFERRED
}

/// Registro de estudiante solo para gestión (sin cuenta ni login en el sistema).
/// `username`/`email` habilitan su cuenta real en Moodle (auth manual).
model Student {
  id         String  @id @default(uuid())
  firstName  String
  lastName   String
  /// Documento identificatorio (opcional; no implica usuario del sistema).
  documentId String?

  /// Usuario para Moodle, formato nombre.apellido (obligatorio en API/UI; nullable por registros históricos).
  username String? @unique

  contactPhone String?
  tutorPhone   String?
  /// Email del alumno (obligatorio en API/UI; nullable por registros históricos). @map preserva la columna histórica `contactEmail`
  /// (renombrarla con `db push` implicaría drop+add y pérdida de datos).
  email        String? @map("contactEmail")
  address      String?

  /// Momento en que se envió el mail de bienvenida a Moodle (exactamente una vez).
  moodleWelcomeSentAt DateTime?

  healthCardExpiresAt DateTime?

  /// Acceso al portal del liceo u otras notas sensibles (opcional).
  liceoAccessNotes String? @db.Text

  internalNotes String? @db.Text

  tuitionYears      StudentTuitionYear[]
  tuitionMonths     StudentTuitionMonth[]
  enrollments       StudentEnrollment[]
  attendanceEntries StudentAttendanceEntry[]

  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  assessmentGrades AssessmentGrade[]
  periodGrades     PeriodGrade[]
  meetingRecords   TeacherMeetingRecord[]

  @@index([lastName, firstName])
}

/// Historial de matrícula por ciclo. Es la fuente nueva para progreso académico:
/// curso/oferta, estado, fechas de salida y resultado quedan versionados por año.
model StudentEnrollment {
  id                     String                  @id @default(uuid())
  studentId              String
  student                Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolYearId           String
  schoolYear             SchoolYear              @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  courseOfferingId       String
  courseOffering         CourseOffering          @relation(fields: [courseOfferingId], references: [id], onDelete: Restrict)
  orientationId          String?
  orientation            Orientation?            @relation(fields: [orientationId], references: [id], onDelete: SetNull)
  courseOrientationId    String?
  courseOrientation      CourseOrientation?      @relation(fields: [courseOrientationId], references: [id], onDelete: SetNull)
  enrollmentStatus       StudentEnrollmentStatus @default(ACTIVE)
  withdrawnAt            DateTime?
  withdrawalAcademicYear Int?
  notes                  String?                 @db.Text
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  attendanceEntries StudentAttendanceEntry[]
  assessmentGrades  AssessmentGrade[]

  @@unique([studentId, schoolYearId])
  @@index([schoolYearId, enrollmentStatus])
  @@index([courseOfferingId])
  @@index([orientationId])
  @@index([courseOrientationId])
}

/// Cuota por año calendario del ciclo (ej. 2025); permite consultar años anteriores.
model StudentTuitionYear {
  id           String      @id @default(uuid())
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolYearId String?
  schoolYear   SchoolYear? @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  year         Int
  paid         Boolean     @default(false)
  paidAt       DateTime?
  amountCents  Int?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, year])
  @@index([year])
  @@index([schoolYearId])
}

/// Mensualidad por estudiante. El año permite conservar historial y filtrar ciclos anteriores.
model StudentTuitionMonth {
  id           String      @id @default(uuid())
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolYearId String?
  schoolYear   SchoolYear? @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  year         Int
  month        Int
  paid         Boolean     @default(false)
  paidAt       DateTime?
  amountCents  Int?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, year, month])
  @@index([year, month])
  @@index([schoolYearId])
}

model Event {
  id                        String                     @id @default(uuid())
  title                     String
  description               String?
  type                      EventType
  status                    EventStatus                @default(SCHEDULED)
  startDate                 DateTime
  endDate                   DateTime?
  startTime                 DateTime?
  endTime                   DateTime?
  location                  String?
  userId                    String
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedUserId            String?
  assignedUser              User?                      @relation("EventAssignment", fields: [assignedUserId], references: [id], onDelete: SetNull)
  schoolYearId              String
  schoolYear                SchoolYear                 @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  courseOfferingId          String?
  courseOffering            CourseOffering?            @relation(fields: [courseOfferingId], references: [id], onDelete: SetNull)
  orientationId             String?
  orientation               Orientation?               @relation(fields: [orientationId], references: [id], onDelete: SetNull)
  courseOrientationId       String?
  courseOrientation         CourseOrientation?         @relation(fields: [courseOrientationId], references: [id], onDelete: SetNull)
  subjectId                 String?
  subject                   Subject?                   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  recurrenceType            RecurrenceType             @default(NONE)
  recurrenceEnd             DateTime?
  isRecurring               Boolean                    @default(false)
  daysOfWeek                Int[]                      @default([]) // Array de días de la semana (0=Domingo, 1=Lunes, etc.)
  parentEventId             String?
  parentEvent               Event?                     @relation("EventRecurrence", fields: [parentEventId], references: [id], onDelete: SetNull)
  childEvents               Event[]                    @relation("EventRecurrence")
  // Versionado temporal de la definición: permite editar una serie a futuro sin
  // reescribir las ocurrencias pasadas (que conservan su asistencia histórica).
  effectiveFrom             DateTime? // Inicio de vigencia de esta versión (null = desde siempre)
  effectiveUntil            DateTime? // Fin de vigencia inclusivo de esta versión (null = sin fin)
  supersededById            String? // Versión que reemplaza a esta (corte de edición)
  supersededBy              Event?                     @relation("EventSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes                Event[]                    @relation("EventSupersession")
  revisionOf                String? // Id de la definición raíz de la serie (agrupa versiones)
  attendances               Attendance[]
  studentAttendanceSessions StudentAttendanceSession[] @relation("StudentAttendanceSessionEvent")
  attendanceIncidents       AttendanceIncident[]
  substitutions             Substitution[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([userId])
  @@index([assignedUserId])
  @@index([schoolYearId])
  @@index([courseOfferingId])
  @@index([orientationId])
  @@index([courseOrientationId])
  @@index([subjectId])
  @@index([startDate])
  @@index([type])
  @@index([revisionOf])
  @@index([effectiveFrom])
}

model Substitution {
  id                    String   @id @default(uuid())
  eventId               String
  event                 Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  originalTeacherUserId String
  originalTeacher       User     @relation("SubstitutionOriginalTeacher", fields: [originalTeacherUserId], references: [id], onDelete: Restrict)
  substituteUserId      String
  substitute            User     @relation("SubstitutionSubstituteTeacher", fields: [substituteUserId], references: [id], onDelete: Restrict)
  date                  DateTime
  startTime             DateTime
  endTime               DateTime
  reason                String
  notes                 String?  @db.Text
  createdByUserId       String?
  createdBy             User?    @relation("SubstitutionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([eventId, date])
  @@index([originalTeacherUserId, date])
  @@index([substituteUserId, date])
  @@index([createdByUserId])
}

// Sistema de Licencias Médicas
enum MedicalLeaveType {
  MEDICAL_LEAVE
  WORK_LEAVE
  OTHER
}

enum MedicalLeaveStatus {
  ACTIVE
  INACTIVE
}

enum NonWorkingDayType {
  HOLIDAY
  NON_WORKING_DAY
}

model NonWorkingDay {
  id           String            @id @default(uuid())
  date         DateTime          @unique
  type         NonWorkingDayType @default(NON_WORKING_DAY)
  reason       String
  notes        String?
  schoolYearId String?
  schoolYear   SchoolYear?       @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
