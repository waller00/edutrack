GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3001
# true solo cuando Grafana se sirve mediante HTTPS.
GRAFANA_COOKIE_SECURE=false
EDUTRACK_APP_NETWORK=edutrack_appnet
PROMETHEUS_RETENTION=15d
POSTGRES_EXPORTER_DATA_SOURCE_NAME=

# Solo para docker-compose.monitoring.tailscale.yml en el droplet.
# Debe ser la IP privada Tailscale del servidor, nunca 0.0.0.0.
TAILSCALE_BIND_ADDRESS=
PROMETHEUS_REMOTE_WRITE_PROXY_IMAGE=nginxinc/nginx-unprivileged:1.27-alpine
