# Plantilla para `docker compose up` en local: `cp .env.compose.example .env`.
#
# Todos los valores tienen default en docker-compose.yml, así que el archivo puede quedar casi
# vacío. Lo que figura acá es lo que conviene conocer o cambiar. No subas el `.env` real al repo.

# --- Base de datos -----------------------------------------------------------
POSTGRES_DB=asistencias
POSTGRES_PASSWORD=postgres
# Local: absorbe cambios destructivos de esquema. En producción va vacío (ver docs/MANUAL_DESPLIEGUE_CONTINUO.md).
PRISMA_DB_PUSH_FLAGS=--accept-data-loss

# --- Sesiones (BFF) ----------------------------------------------------------
REDIS_URL=redis://redis:6379
SESSION_TTL_DAYS=7
# Firma tokens de un solo uso (p. ej. desactivar 2FA por correo). Cambialo fuera de tu máquina.
JWT_SECRET=dev-jwt-secret-change-me
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- URLs --------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Orígenes extra permitidos por CORS, separados por coma.
CORS_ORIGINS=

# --- Keycloak ----------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ISSUER_URL=http://localhost:8089/realms/edutrack
# También es la URL pública de la API para los enlaces que salen por correo (2FA).
KEYCLOAK_REDIRECT_URI=http://localhost:4000/auth/callback
KEYCLOAK_CLIENT_ID=edutrack-web
KEYCLOAK_CLIENT_SECRET=edutrack-web-secret-change-me

# --- Herramientas de prueba (simular lector, limpiar datos). Nunca en producción.
ALLOW_ADMIN_TESTING_TOOLS=1

# --- Opcionales ----------------------------------------------------------------
# Correo (SMTP o Brevo)
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BREVO_API_KEY=

# Opcional: SMTP propio de Keycloak. Recuperar contraseña ya NO lo usa (lo manda EduTrack por
# Brevo); sólo sirve si se vuelve a usar un correo nativo de Keycloak. Lo aplica
# scripts/keycloak-apply-realm-settings.sh. DigitalOcean bloquea 25/465/587: relay de Brevo en el
# 2525, con la clave SMTP de Brevo (SMTP & API > SMTP), no BREVO_API_KEY.
# Sin KEYCLOAK_SMTP_FROM usa SMTP_FROM (remitente verificado en Brevo).
KEYCLOAK_SMTP_HOST=smtp-relay.brevo.com
KEYCLOAK_SMTP_PORT=2525
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASSWORD=
KEYCLOAK_SMTP_FROM=

# Captcha de registro (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Notificaciones push (generar con `npm run vapid:keys` en backend/)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Observabilidad
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_LOGROCKET_APP_ID=

# Moodle (la integración queda inactiva sin MOODLE_BASE_URL y MOODLE_WS_TOKEN)
MOODLE_BASE_URL=
MOODLE_WS_TOKEN=
MOODLE_SYNC_ENABLED=false
MOODLE_ROLE_TEACHER_ID=3
MOODLE_ROLE_STUDENT_ID=5

# Lector biométrico de prueba que crea `npm run seed:biometric` (backend/prisma/seed-biometric-adms.mjs)
BIOMETRIC_DEVICE_CODE=
BIOMETRIC_DEVICE_NAME=
BIOMETRIC_DEVICE_SECRET=
BIOMETRIC_ADMS_SERIAL=
