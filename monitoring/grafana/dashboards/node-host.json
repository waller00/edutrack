{
  "uid": "edutrack-node-host",
  "title": "Node Host",
  "tags": [
    "edutrack",
    "host",
    "node-exporter"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "legendFormat": "{{ instance }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "Sin datos"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory usage",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "{{ instance }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "Sin datos"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Disk available",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|proc|sysfs|devtmpfs\"}",
          "legendFormat": "{{ mountpoint }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Sin datos"
        },
        "overrides": []
      }
    }
  ],
  "links": [
    {
      "title": "Estado general",
      "type": "link",
      "url": "/d/edutrack-overview",
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Backend",
      "type": "link",
      "url": "/d/edutrack-backend-red",
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Logs",
      "type": "link",
      "url": "/d/edutrack-logs-loki",
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "WAF",
      "type": "link",
      "url": "/d/waf-security",
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "CrowdSec",
      "type": "link",
      "url": "/d/crowdsec-observation",
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Servidor",
      "type": "link",
      "url": "/d/edutrack-node-host",
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "PostgreSQL",
      "type": "link",
