      "id": 1,
      "type": "stat",
      "title": "Respuestas 444/403/405 (no prueban ataque)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "unit": "short",
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({compose_project=\"edutrack\",compose_service=\"reverse-proxy\"} | regexp `^(?P<ip>[0-9a-fA-F:.]+) - [^ ]* \\[[^]]+\\] \"(?P<method>[A-Z]+) (?P<path>[^ ]+) [^\"]+\" (?P<status>[0-9]{3}) ` | status!=\"\" | status=~\"444|403|405\" [$__range]))"
        }
      ],
      "description": "Los códigos HTTP no identifican por sí solos quién bloqueó ni prueban un ataque. Los eventos WAF explícitos aportan el motivo. El total cuenta solo access logs, sin duplicar eventos WAF."
