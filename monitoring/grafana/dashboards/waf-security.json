    {
      "id": 1,
      "type": "stat",
      "title": "Bloqueos (444/403/405)",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" }, "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "queryType": "instant", "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({container=\"edutrack-reverse-proxy-1\"} | pattern `<ip> - <_> [<_>] \"<method> <path> <_>\" <status> <_>` | status=~\"444|403|405\" [$__range]))" }
      ]
    },
