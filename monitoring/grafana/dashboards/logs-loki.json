{
  "uid": "edutrack-logs-loki",
  "title": "Logs Loki",
  "tags": [
    "edutrack",
    "logs",
    "loki"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Auth logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "{compose_project=\"edutrack\",compose_service=\"auth\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Web logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "expr": "{compose_project=\"edutrack\",compose_service=\"web\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Respuestas HTTP 5xx del backend por intervalo",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "sum(count_over_time({compose_project=\"edutrack\",compose_service=\"auth\"} | regexp `^(?P<method>[A-Z]+) (?P<path>[^ ]+) (?P<status>[0-9]{3}) [0-9.]+ ms -` | status=~\"5[0-9]{2}\" [$__auto]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "description": "Solo líneas de acceso con estado HTTP 5xx. Un 500 en una ruta, duración o tamaño no cuenta como error."
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Solicitudes del backend con respuesta 5xx",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "expr": "{compose_project=\"edutrack\",compose_service=\"auth\"} | regexp `^(?P<method>[A-Z]+) (?P<path>[^ ]+) (?P<status>[0-9]{3}) [0-9.]+ ms -` | status=~\"5[0-9]{2}\"",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true
      }
    }
  ],
  "links": [
    {
