{
  "uid": "edutrack-backend-red",
  "title": "Backend RED",
  "tags": [
    "edutrack",
    "backend",
    "red"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Backend ready",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "probe_success{instance=\"http://auth:4000/ready\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "NOT READY"
                },
                "1": {
                  "text": "READY"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "Sin datos"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests / second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(edutrack_backend_http_requests_total{job=\"edutrack-backend\",route!~\"/health|/ready|/metrics\"}[1m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "description": "Excluye sondas /health, /ready y /metrics en contadores e histogramas. Interpretar latencias junto con el volumen; in-flight incluye todas las solicitudes activas."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "HTTP 5xx rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "(sum(rate(edutrack_backend_http_requests_total{job=\"edutrack-backend\",route!~\"/health|/ready|/metrics\",status_code=~\"5..\"}[5m])) or (0 * sum(rate(edutrack_backend_http_requests_total{job=\"edutrack-backend\",route!~\"/health|/ready|/metrics\"}[5m])))) / (sum(rate(edutrack_backend_http_requests_total{job=\"edutrack-backend\",route!~\"/health|/ready|/metrics\"}[5m])) > 0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "description": "Excluye sondas /health, /ready y /metrics en contadores e histogramas. Interpretar latencias junto con el volumen; in-flight incluye todas las solicitudes activas."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requests in flight",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(edutrack_backend_http_requests_in_flight)",
          "refId": "A"
        }
      ],
      "description": "Excluye sondas /health, /ready y /metrics en contadores e histogramas. Interpretar latencias junto con el volumen; in-flight incluye todas las solicitudes activas.",
      "fieldConfig": {
        "defaults": {
          "noValue": "Sin datos"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by route and status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum by (route, status_code) (rate(edutrack_backend_http_requests_total{job=\"edutrack-backend\",route!~\"/health|/ready|/metrics\"}[1m]))",
          "legendFormat": "{{ route }} {{ status_code }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "description": "Excluye sondas /health, /ready y /metrics en contadores e histogramas. Interpretar latencias junto con el volumen; in-flight incluye todas las solicitudes activas."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency percentiles",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(edutrack_backend_http_request_duration_seconds_bucket{job=\"edutrack-backend\",route!~\"/health|/ready|/metrics\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(edutrack_backend_http_request_duration_seconds_bucket{job=\"edutrack-backend\",route!~\"/health|/ready|/metrics\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(edutrack_backend_http_request_duration_seconds_bucket{job=\"edutrack-backend\",route!~\"/health|/ready|/metrics\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "description": "Excluye sondas /health, /ready y /metrics en contadores e histogramas. Interpretar latencias junto con el volumen; in-flight incluye todas las solicitudes activas."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "p95 latency by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, route) (rate(edutrack_backend_http_request_duration_seconds_bucket{job=\"edutrack-backend\",route!~\"/health|/ready|/metrics\"}[5m]))))",
          "legendFormat": "{{ route }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "description": "Excluye sondas /health, /ready y /metrics en contadores e histogramas. Interpretar latencias junto con el volumen; in-flight incluye todas las solicitudes activas."
    }
  ],
  "links": [
