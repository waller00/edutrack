{
  "uid": "edutrack-docker-containers",
  "title": "Docker Containers",
  "tags": [
    "edutrack",
    "docker",
    "cadvisor"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU por cgroup (núcleos)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "topk(10, sum by (id) (rate(container_cpu_usage_seconds_total{id!=\"/\", cpu=\"total\"}[5m])))",
          "legendFormat": "{{ id }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin datos"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memoria working set por cgroup",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "topk(10, container_memory_working_set_bytes{id!=\"/\"})",
          "legendFormat": "{{ id }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "description": "IDs de cgroup, no necesariamente contenedores Docker identificados."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Network receive/transmit",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (interface) (rate(container_network_receive_bytes_total[5m]))",
          "legendFormat": "{{ interface }} rx",
          "refId": "A"
        },
        {
          "expr": "sum by (interface) (rate(container_network_transmit_bytes_total[5m]))",
          "legendFormat": "{{ interface }} tx",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "Sin datos"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Series de memoria con nombre de contenedor",
      "type": "stat",
      "description": "Si está sin datos, cAdvisor no aporta nombres: los gráficos por id pueden incluir cgroups y no permiten atribuir consumo con precisión. Revisar compatibilidad/runtime de cAdvisor antes de sacar conclusiones.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(container_memory_working_set_bytes{job=\"cadvisor\",name!=\"\"})",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin datos",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    }
  ],
  "links": [
    {
      "title": "Estado general",
      "type": "link",
      "url": "/d/edutrack-overview",
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Backend",
      "type": "link",
      "url": "/d/edutrack-backend-red",
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Logs",
      "type": "link",
      "url": "/d/edutrack-logs-loki",
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "WAF",
      "type": "link",
      "url": "/d/waf-security",
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "CrowdSec",
      "type": "link",
      "url": "/d/crowdsec-observation",
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Servidor",
      "type": "link",
      "url": "/d/edutrack-node-host",
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "PostgreSQL",
      "type": "link",
