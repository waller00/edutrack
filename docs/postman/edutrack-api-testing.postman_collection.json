{
  "info": {
    "_postman_id": "b8efdc6b-0d9d-4c6f-a5e6-edutrack-testing",
    "name": "EduTrack API Testing - DEV-T7029 a DEV-T7126",
    "description": "Colección organizada para ejecutar las pruebas API Postman del plan DEV-T7029 a DEV-T7126. Ajustar variables antes de correr: baseUrl, credenciales, IDs y tokens. El header X-Expected-Status lo usa el test común para validar el estado HTTP esperado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expected = pm.request.headers.get('X-Expected-Status');",
          "if (expected) {",
          "  const allowed = expected.split(',').map((x) => Number(x.trim())).filter(Boolean);",
          "  pm.test(`HTTP esperado (${expected})`, function () {",
          "    pm.expect(pm.response.code).to.be.oneOf(allowed);",
          "  });",
          "}",
          "let json = null;",
          "try { json = pm.response.json(); } catch (e) {}",
          "if (json && typeof json === 'object') {",
          "  const pairs = [",
          "    ['id', 'lastId'],",
          "    ['exportId', 'exportId'],",
          "    ['token', 'lastToken'],",
          "    ['twoFactorToken', 'twoFactorToken'],",
          "    ['sessionId', 'diditSessionId'],",
          "    ['diditSessionId', 'diditSessionId'],",
          "    ['verificationUrl', 'diditVerificationUrl'],",
          "    ['courseOfferingId', 'courseOfferingId']",
          "  ];",
          "  for (const [key, variable] of pairs) {",
          "    if (json[key]) pm.collectionVariables.set(variable, json[key]);",
          "  }",
          "  if (json.id && pm.info.requestName.includes('Crear curso')) pm.collectionVariables.set('courseId', json.id);",
          "  if (json.id && pm.info.requestName.includes('Crear evento')) pm.collectionVariables.set('eventId', json.id);",
          "  if (json.id && pm.info.requestName.includes('Crear estudiante')) pm.collectionVariables.set('studentId', json.id);",
          "  if (json.id && pm.info.requestName.includes('Crear licencia')) pm.collectionVariables.set('licenseId', json.id);",
          "  if (json.id && pm.info.requestName.includes('Crear día no laborable')) pm.collectionVariables.set('nonWorkingDayId', json.id);",
          "  if (json.token && pm.info.requestName.includes('Resetear contraseña')) pm.collectionVariables.set('resetToken', json.token);",
          "  if (json.data && Array.isArray(json.data) && json.data[0]?.id) pm.collectionVariables.set('lastListId', json.data[0].id);",
          "}"
        ]
      }
    }
  ],
