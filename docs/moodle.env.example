# Copiar en el VPS de Moodle y levantar con --env-file:
#   cp docs/moodle.env.example .env
#   docker compose -f docker-compose.moodle.yml --env-file .env up -d
#
# Desarrollo local (default del compose si no hay .env):
#   MOODLE_HOST=localhost:8080
#   MOODLE_SSLPROXY=no
#   MOODLE_REVERSEPROXY=no
#
# Producción (https://moodle.edutrack-uy.com detrás de nginx/Caddy):
MOODLE_HOST=moodle.edutrack-uy.com
MOODLE_SSLPROXY=yes
MOODLE_REVERSEPROXY=yes
# Bitnami Moodle 5.x: si sslproxy no se aplica, probá también las variantes con guión bajo:
MOODLE_SSL_PROXY=yes
MOODLE_REVERSE_PROXY=yes

# Tras el primer despliegue con localhost, corregir config.php existente (una vez):
#   MOODLE_PUBLIC_URL=https://moodle.edutrack-uy.com ./scripts/moodle-fix-production.sh
